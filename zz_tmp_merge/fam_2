/** guest -> family or kid -> kid: move progress around without losing photos */
async function loadKid(k: KidDoc) {
  const l = lget(); if (l.mode === "family" && l.kid === k.id) return;
  if (l.mode === "family" && l.kid && l.kid !== k.id) { clearLocal(l.kid); }
  else if (l.mode !== "family") { try { localStorage.setItem(GUEST_BACKUP, JSON.stringify(snapshot())); } catch { /* too big */ } }
  lastPushed = {}; lastShowcase = ""; activeKid = k.id; lset({ mode: "family", kid: k.id, kidName: k.name });
  if (isOnline() && USER) {
    let newest = 0, remote: Record<string, { json: string; at: number }> = {};
    for (const key of SYNC) { const r = await B.getData(USER.uid, k.id, sdoc(key)).catch(() => null); if (r) { remote[key] = r; newest = Math.max(newest, r.at); } }
    if (newest > 0) { for (const key of Object.keys(remote)) writeKey(key, remote[key].json); restoreStash(k.id); }
    else if (anyLocal()) { const stamp = Date.now(); for (const key of SYNC) { const v = readKey(key); if (v != null) await B.setData(USER.uid, k.id, sdoc(key), v, stamp).catch(() => {}); } }
    try { const soc = readKey("unify.social.v1"); if (soc) { const j = JSON.parse(soc); if (j.kid !== k.name) { j.kid = k.name; writeKey("unify.social.v1", JSON.stringify(j)); } } } catch { /* no social yet */ }
  }
  setParentGrade(k.grade ?? 0); window.dispatchEvent(new Event("unify:social")); window.dispatchEvent(new Event("unify:progress")); await refreshShowcaseVisibility(); void syncNow("init"); buttonRefresh();
}
