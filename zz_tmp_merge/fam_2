function setSyncMsg(m: string) { syncMsg = m; buttonRefresh(); }
/** push local progress up; pull anything newer down; then update the badge */
async function syncNow(reason: string) {
  if (!USER || !activeKid || !isOnline() || pushing) return; pushing = true; setSyncMsg("syncing...");
  try {
    for (const k of SYNC) {
      const [cloud, local] = await Promise.all([B.getData(USER.uid, activeKid, sdoc(k)).catch(() => null), Promise.resolve(readKey(k))]);
      const stamp = Number((local && JSON.parse(local).at) || 0), cloudAt = cloud?.at ?? 0, mine = local == null ? "" : JSON.stringify(local);
      if (local != null && stamp >= cloudAt && lastPushed[k] !== mine) { await B.setData(USER.uid, activeKid, sdoc(k), local, stamp); lastPushed[k] = mine; }
      else if (cloud && cloudAt > stamp) { writeKey(k, cloud.json); if (k === "unify.social.v1") window.dispatchEvent(new Event("unify:social")); }
    }
    // last write wins for keys with no timestamp (avatar changes etc.)
    for (const k of SYNC) if (["unify.social.v1", "unify.dorm.v1"].includes(k) && readKey(k) != null) { const local = readKey(k)!, mine = JSON.stringify(local); if (lastPushed[k] !== mine) { await B.setData(USER.uid, activeKid, sdoc(k), local, Date.now()); lastPushed[k] = mine; } }
    await publishShowcase();
    if (reason !== "init") setSyncMsg("saved " + new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" }));
    else setSyncMsg("");
  } catch { setSyncMsg("offline"); } finally { pushing = false; buttonRefresh(); }
}
