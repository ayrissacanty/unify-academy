}
function scrReport(kidId: string) {
  const k = KIDS.find((x) => x.id === kidId), l = lget();
  const own = l.mode === "family" && l.kid === kidId;
  show(`<h2>${k ? k.name + "'s report" : "Report"}</h2><div id="fR"></div><div class="fm-row"><button class="fm-b" id="fBack">Back</button></div>`);
  (panel.querySelector("#fBack") as HTMLButtonElement).onclick = () => route();
  const box = panel.querySelector("#fR") as HTMLElement;
  if (!own) { E("p", "", box, "Reports show the progress saved on this device. Ask them to open this on their own tablet to see theirs."); return; }
  const rows = gradesFromState();
  if (!rows.length) { E("p", "", box, "No graded work yet. Finish a class to see grades here."); return; }
  const t = E("table", "fm-tb", box); t.innerHTML = "<tr><th>Subject</th><th>Grade</th><th>Done</th></tr>";
  for (const [sub, g, n] of rows) { const tr = E("tr", "", t); E("td", "", tr, SUBJECT_NAME[sub] ?? sub); E("td", "", tr, g); E("td", "", tr, String(n)); }
}

/* ---------------- the always-visible corner button ---------------- */
function buttonRefresh() {
  if (!btn) return; const l = lget();
  if (l.mode === "family" && l.kidName) { btn.textContent = (l.kidName[0] || "?").toUpperCase(); btn.style.background = kidColor(); btn.style.color = "#fff"; btn.title = `${l.kidName} (family account) ${syncMsg}`; }
  else { btn.textContent = "\u{1F46A}"; btn.style.background = ""; btn.style.color = ""; btn.title = "Family accounts"; }
}

/** child-side sign-in: pick the family's child after a successful kid login */
