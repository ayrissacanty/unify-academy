  let age = k?.age ?? "6-8", grade = k?.grade ?? 0, color = k?.color ?? COLORS[KIDS.length % COLORS.length];
  const aa = panel.querySelector("#fA") as HTMLElement; for (const a of ["3-5", "6-8", "9-11", "12+"]) { const b = E("button", "fm-b" + (a === age ? " pri" : ""), aa, a); b.onclick = () => { age = a; aa.querySelectorAll("button").forEach((x) => x.classList.remove("pri")); b.classList.add("pri"); }; }
  const gg = panel.querySelector("#fG") as HTMLElement; for (let g = 0; g <= 8; g++) { const b = E("button", "fm-b" + (g === grade ? " pri" : ""), gg, g ? String(g) : "K"); b.onclick = () => { grade = g; gg.querySelectorAll("button").forEach((x) => x.classList.remove("pri")); b.classList.add("pri"); }; }
  const cc = panel.querySelector("#fC") as HTMLElement; for (const c of COLORS) { const b = E("button", c === color ? "on" : "", cc); b.style.background = c; b.onclick = () => { color = c; cc.querySelectorAll("button").forEach((x) => x.classList.remove("on")); b.classList.add("on"); }; }
  (panel.querySelector("#fBack") as HTMLButtonElement).onclick = () => scrKids();
  const kidMsg = (m: string) => { const el = panel.querySelector("#fKS") as HTMLElement | null; if (el) el.textContent = m; };
  if (k && B.createKidLogin) {
    if (k.login_email) kidMsg(`Signs in as ${k.login_email}`);
    (panel.querySelector("#fMake") as HTMLButtonElement).onclick = async () => {
      const local = (panel.querySelector("#fL") as HTMLInputElement).value.trim().toLowerCase().replace(/[^a-z0-9.+-]/g, ""), pw = (panel.querySelector("#fKP") as HTMLInputElement).value;
      if (!local) return kidMsg("Type a first name for the address."); if (pw.length < 8) return kidMsg("The password needs 8+ characters.");
      try { const email = await B.createKidLogin!(k.id, local, pw); k.login_email = email; kidMsg(`Done! Signs in as ${email}`); }
      catch (e) { kidMsg(errText(e)); }
    };
    (panel.querySelector("#fRm") as HTMLButtonElement).onclick = async () => { try { await B.removeKidLogin!(k.id); k.login_email = null; kidMsg("Removed."); } catch (e) { kidMsg(errText(e)); } };
  }
  (panel.querySelector("#fSave") as HTMLButtonElement).onclick = async () => {
    const name = (panel.querySelector("#fN") as HTMLInputElement).value.trim(), pin = (panel.querySelector("#fPin") as HTMLInputElement).value, x = panel.querySelector("#fX") as HTMLElement;
    if (!name) { x.textContent = "They need a nickname."; return; }
    if (!k && !/^\d{4}$/.test(pin)) { x.textContent = "Pick a 4-digit code."; return; }
    if (pin && !/^\d{4}$/.test(pin)) { x.textContent = "The code is 4 digits."; return; }
    const doc: KidDoc = k ?? { id: "k" + rnd(6), name, age, salt: "", hash: "", created: Date.now() };
    doc.name = name; doc.age = age; doc.grade = grade; doc.color = color;
    if (pin) { doc.salt = rnd(8); doc.hash = await hashPin(doc.salt, pin); }
    try { await B.saveKid(USER!.uid, doc); } catch (e) { x.textContent = errText(e); return; }
    if (!k) KIDS.push(doc);
