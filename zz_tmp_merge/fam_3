
  show(`<h2>${k ? "Edit " + k.name : "Add a child"}</h2>
  <div class="fm-lab">Nickname (what friends see)</div><input class="fm-in" id="fN" maxlength="16" value="${(k?.name ?? "").replace(/"/g, "&quot;")}">
