/** the child's own sign-in from the start screen (academy address + password, no parent needed) */
export async function kidSignIn(email: string, password: string): Promise<string | null> {
  if (!B.signInKid) return "Student sign-in isn't set up here.";
  try { kidSigningIn = true; const s = await B.signInKid(email, password); kidLogin = true; USER = { uid: s.family, email: null, verified: true }; KIDS = [s.kid]; await loadKid(s.kid); return null; }
  catch (e) { return errText(e); } finally { kidSigningIn = false; }
}

/* ---------------- boot ---------------- */
export function initFamily(opts: { anchor?: HTMLElement } = {}) {
  const st = document.createElement("style"); st.textContent = CSS; document.head.appendChild(st);
  root = E("div", "", document.body); root.id = "fam"; panel = E("div", "fm-p", root);
  root.addEventListener("click", (e) => { if (e.target === root) close(); });
  btn = E("button", "fm-fambtn", opts.anchor ?? document.body) as HTMLButtonElement;
  btn.id = "famBtn"; btn.style.cssText = "position:fixed;top:10px;right:10px;z-index:110;width:44px;height:44px;border-radius:50%;border:1px solid rgba(255,255,255,.8);background:#FFF9F0;font-size:20px;cursor:pointer;box-shadow:0 2px 0 var(--edge,#C9B28A)";
  btn.onclick = () => openFamily();
  B = (window as any).__FAMILY_BACKEND ?? (((window as any).__supaReady ? supabaseBackend() : null) as Backend);
  buttonRefresh();
  if (!B) return;
  B.onUser(async (u) => {
    if (kidSigningIn) return;                      // the child's own sign-in flow handles itself
    USER = u; kidLogin = false;
    if (u) {
      try { PROFILE = await B.profile(u.uid); PROFILE_LOADED = true; } catch { PROFILE_LOADED = true; }
      try { KIDS = await B.kids(u.uid); } catch { KIDS = []; }
      // did this device belong to one of these children?
      const l = lget();
      if (l.mode === "family" && l.kid && !KIDS.some((k) => k.id === l.kid)) signOutToGuest();
      else if (l.mode === "family" && l.kid) { const k = KIDS.find((x) => x.id === l.kid)!; activeKid = k.id; void syncNow("init"); }
      // a kid sign-in that lands here means a child typed an academy address into the parent form
      if (!kidLogin && B.kidLogin) { try { const s = await B.kidLogin(); if (s) { kidLogin = true; USER = { uid: s.family, email: null, verified: true }; KIDS = [s.kid]; await loadKid(s.kid); } } catch { /* not a kid */ } }
    } else { KIDS = []; }
    buttonRefresh();
  });
  // save whenever the tab hides, and every 40 s while it shows
  let vis = true; document.addEventListener("visibilitychange", () => { vis = !document.hidden; if (!vis) void syncNow("hide"); });
  setInterval(() => { if (vis) void syncNow("tick"); }, 40000);
  addEventListener("unify:progress", () => void syncNow("progress"));
}
